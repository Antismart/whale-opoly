# Torii indexer. Cartridge Slot deployments were discontinued (the hosted
# endpoint returns 410 Gone), so run one locally:
#   contracts/run-torii-sepolia.sh
VITE_TORII_URL=http://localhost:8080

VITE_WORLD_ADDRESS=0x0383a3e99dbe9407adac729ec343a84d8c291e04103eb5f3504fbe89afa76608
VITE_WORLD_BLOCK=8365014

# Session keys. true  = one signature, then prompt-free play, gas sponsored.
#                false = a signature per move, player pays their own Sepolia ETH.
# Switch to false when sponsorship is down ("AVNU sponsorship failed").
VITE_SESSION_KEYS=true
