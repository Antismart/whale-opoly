# Local Torii. Cartridge Slot deployments were discontinued (the hosted
# endpoint returns 410 Gone), so the indexer runs on this machine against
# the same Sepolia world. Previous hosted value kept in .env.slot-backup.
VITE_TORII_URL=http://localhost:8080
VITE_WORLD_ADDRESS=0x0383a3e99dbe9407adac729ec343a84d8c291e04103eb5f3504fbe89afa76608
VITE_WORLD_BLOCK=8365014

# Session keys. Default (unset or true): Cartridge pre-approves the game's
# entrypoints and a paymaster sponsors gas — one signature, then prompt-free
# play. Set to false if sponsorship is unavailable ("AVNU sponsorship failed"):
# the player then approves each move and pays their own Sepolia ETH.
VITE_SESSION_KEYS=true
